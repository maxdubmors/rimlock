{
  "name": "rimlock",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "26.11.1",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "build": "pnpm build:core && pnpm --filter @rimlock/extension build",
    "build:core": "scripts/build-core.sh",
    "dev": "scripts/build-core.sh dev-wasm && pnpm --filter @rimlock/extension dev",
    "check": "pnpm check:ts && pnpm check:rust",
    "check:ts": "pnpm --filter @rimlock/extension check",
    "check:rust": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "check:core-bindings": "scripts/check-core-bindings.sh",
    "test": "pnpm build:core && pnpm test:ts && pnpm test:rust",
    "test:ts": "pnpm --filter @rimlock/extension test",
    "test:rust": "cargo test --locked",
    "test:e2e": "pnpm build:core && pnpm --filter @rimlock/extension test:e2e"
  }
}
