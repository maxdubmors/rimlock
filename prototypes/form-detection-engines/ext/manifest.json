{
  "manifest_version": 3,
  "name": "rimlock shadow-root check (throwaway)",
  "version": "0.0.1",
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "browser_specific_settings": { "gecko": { "id": "shadow-check@rimlock.invalid" } }
}
