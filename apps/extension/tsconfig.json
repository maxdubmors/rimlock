{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // engineering.md § Checks; repeated here so a WXT upgrade cannot drop one.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true
  },
  // The lint fixtures break rules on purpose; tests/lint/fixtures/tsconfig.json covers them.
  "exclude": ["node_modules", ".output", "tests/lint/fixtures"]
}
